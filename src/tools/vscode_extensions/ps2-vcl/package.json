{
    "name": "ps2-vcl",
    "displayName": "PS2 VCL, VUSL and VU Assembly",
    "description": "Syntax highlighting for PlayStation 2 VU microprograms: VUSL sources (.vusl) and their includes (.vush), VCL (with oxide-vcl's preprocessor directives) and its shared .i includes, and raw VU assembly (.vsm).",
    "version": "0.1.0",
    "publisher": "PS2_QUAKE",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "ps2-vcl",
                "aliases": [
                    "PS2 VCL",
                    "VU Assembly"
                ],
                "extensions": [
                    ".vcl",
                    ".vsm"
                ],
                "filenamePatterns": [
                    "**/vu1progs/*.i"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "vusl",
                "aliases": [
                    "VUSL",
                    "VU Shading Language"
                ],
                "extensions": [
                    ".vusl",
                    ".vush"
                ],
                "configuration": "./vusl-language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ps2-vcl",
                "scopeName": "source.vcl.ps2",
                "path": "./syntaxes/vcl.tmLanguage.json"
            },
            {
                "language": "vusl",
                "scopeName": "source.vusl",
                "path": "./syntaxes/vusl.tmLanguage.json"
            }
        ]
    }
}
